<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>chatsweb</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
   <h1> All Chats!</h1> 
   <form method="GET" action="/chats/new">
    <button>New-Chat</button>
   </form>
   <%for(let chat of chats){ %>
    <div class="chatbox">
       <p>From:<i> <%=chat.from %></i> </p>
       <div class="mag">
        <p><%= chat.msg %></p>
        
       </div>
       <form method="GET" action="/chats/<%= chat._id %>/edit">
       <button>Edit</button></form>
       <p>Receved by:<i><%=chat.to%></i></p>
       <p>Time:<%=chat.created_at.toString().split(" ")[4]  %></p>
       <p>Date:<%=chat.created_at.toString().split(" ").slice(1,4).join("/")  %></p>
    </div>
    
<%}%> 


</body>
</html>
